{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/_aitna/.akmon/hooks/codex-hook.py\" role-on-code",
            "statusMessage": "Checking akmon role switch"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/_aitna/.akmon/hooks/codex-hook.py\" analysis-guard",
            "statusMessage": "Checking analysis-before-mutation"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/_aitna/.akmon/hooks/codex-hook.py\" d2-ledger-reminder",
            "statusMessage": "Checking D2 ledger"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/_aitna/.akmon/hooks/codex-hook.py\" session-start",
            "statusMessage": "Loading akmon session reminders"
          }
        ]
      }
    ]
  }
}
